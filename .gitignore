# Compiled translation catalog. Generated from the .ts by
# tools/compile_translations.bat, which run_from_source.bat and
# tools/run_tests.bat both call. Tracking it made every branch that added a
# string conflict on a binary.
translations/*.qm
IAMGAY.md

# Local, not source: graphify's generated knowledge graph, and screenshots
# kept for reference (the folder name says it).
graphify-out/
pic_donttrack/
